# Database Configuration
# Supabase PostgreSQL via the Supavisor session-mode pooler.
# Notes:
# - The direct db.<project-ref>.supabase.co hostname is IPv6-only; use the pooler for IPv4.
# - Username format is "postgres.<project-ref>". Port 5432 = session mode (works with Prisma).
#   Do NOT use port 6543 (transaction mode) - it breaks Prisma's prepared statements.
# - Keep "sslmode=require&uselibpqcompat=true": Supabase presents a self-signed CA, and pg
#   treats sslmode=require as full verification without the compat flag.
# - Percent-encode special characters in the password (a literal % becomes %25).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true"

# Supabase Storage (Medical Documents, blueprint Section 13). Server-side only - the
# service_role key must never be exposed to the browser; downloads use signed URLs.
# Secret key comes from Dashboard -> Project Settings -> API Keys (service_role JWT
# or sb_secret_... format). It is an API key, not a database connection string.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Providers
# Primary: Groq (vet chat + booking assistant). Fallback: Gemini. Landing chat: OpenRouter.
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-gemini-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"

# Google OAuth (login)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
